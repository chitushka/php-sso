SSO_ENV=development
SSO_ISSUER=http://localhost:8080
SSO_API_AUDIENCE=http://localhost:8080/api
SSO_DATABASE_URL=
SSO_DB_HOST=postgres
SSO_DB_PORT=5432
SSO_DB_NAME=sso
SSO_DB_USER=sso
SSO_DB_PASSWORD=sso
SSO_JWT_SECRET=development-jwt-secret-at-least-32-chars
SSO_ENCRYPTION_KEY=development-encryption-key-32-chars
SSO_COOKIE_SECURE=false
SSO_CACHE_DRIVER=file
SSO_RATE_LIMIT_PER_MINUTE=1000
SSO_RATE_LIMIT_BURST=1000
SSO_METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
SSO_CLEANUP_INTERVAL=3600
POSTGRES_DB=sso
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso
