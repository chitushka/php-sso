SSO_ENV=prod
SSO_ISSUER=https://localhost:8443
SSO_API_AUDIENCE=https://localhost:8443/api
SSO_CUTOVER_EXPECTED_ISSUER=https://localhost:8443
SSO_DATABASE_URL=postgres://sso:change-me@postgres:5432/sso?sslmode=verify-full&sslrootcert=/tls/server.crt
# Любой чувствительный параметр можно передать через NAME_FILE вместо NAME.
# SSO_DATABASE_URL_FILE=/run/secrets/database-url
SSO_JWT_SECRET_FILE=/run/secrets/jwt-secret
SSO_ENCRYPTION_KEY_FILE=/run/secrets/encryption-key
SSO_ALLOW_PLAINTEXT_SECRETS=false
SSO_ACCESS_TOKEN_TTL=900
SSO_SESSION_TTL=2592000
SSO_REFRESH_TOKEN_TTL=2592000
SSO_COOKIE_SECURE=true
SSO_MAX_BODY_BYTES=1048576
SSO_RATE_LIMIT_PER_MINUTE=30
SSO_RATE_LIMIT_BURST=10
SSO_CACHE_DRIVER=db
SSO_TRUSTED_PROXIES=172.31.250.10
# Только явно доверенные внутренние mock/RP-хосты; в production обычно оставляется пустым.
SSO_OUTBOUND_HOST_ALLOWLIST=
SSO_OUTBOUND_CONNECT_TIMEOUT=5
SSO_OUTBOUND_READ_TIMEOUT=10
SSO_OUTBOUND_MAX_RESPONSE_BYTES=1048576
SSO_LDAP_ALLOWED_HOSTS=ldap.example.com
SSO_LDAP_CA_CERT=/run/secrets/ldap-ca.pem
SSO_LDAP_ALLOW_INSECURE=false
SSO_LDAP_NETWORK_TIMEOUT=5
SSO_SMTP_HOST=
SSO_SMTP_PORT=25
SSO_SMTP_USERNAME=
SSO_SMTP_PASSWORD=
# SSO_SMTP_PASSWORD_FILE=/run/secrets/smtp-password
SSO_SMTP_FROM=
SSO_SMTP_STARTTLS=false
SSO_SMTP_CA_CERT=
SSO_AUDIT_RETENTION_DAYS=365
SSO_CLEANUP_BATCH_SIZE=1000
SSO_CLEANUP_INTERVAL=3600
SSO_METRICS_ALLOWED_CIDRS=10.0.0.0/8
# SSO_METRICS_BEARER_TOKEN_FILE=/run/secrets/metrics-token
# Опциональные credentials выделенного пользователя и зарегистрированного клиента для cutover-smoke-authenticated.
SSO_CUTOVER_SMOKE_USERNAME=
SSO_CUTOVER_SMOKE_PASSWORD=
SSO_CUTOVER_SMOKE_MFA_CODE=
SSO_CUTOVER_SMOKE_CLIENT_ID=
SSO_CUTOVER_SMOKE_CLIENT_SECRET=
SSO_CUTOVER_SMOKE_REDIRECT_URI=
SSO_CUTOVER_SMOKE_LOGOUT_REDIRECT_URI=
SSO_CUTOVER_SMOKE_SCOPE=openid profile email
SSO_CUTOVER_SMOKE_GRANT_CONSENT=false
POSTGRES_DB=sso
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso
