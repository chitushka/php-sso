    "/api/v1/bootstrap": {"post": {"operationId": "bootstrapSystem", "tags": ["Bootstrap"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/Bootstrap"}, "responses": {"201": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/broker/providers": {"get": {"operationId": "listPublicBrokerProviders", "tags": ["Federation"], "security": [], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}}}},

    "/api/v1/auth/login": {"post": {"operationId": "login", "tags": ["Authentication"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/Login"}, "responses": {"200": {"$ref": "#/components/responses/LoginResult"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/password/forgot": {"post": {"operationId": "forgotPassword", "tags": ["Account"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/auth/password/reset": {"post": {"operationId": "resetPassword", "tags": ["Account"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/auth/password/change": {"post": {"operationId": "changePassword", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/profile": {"put": {"operationId": "updateProfile", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/email/request": {"post": {"operationId": "requestEmailVerification", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/email/verify": {"post": {"operationId": "verifyEmail", "tags": ["Account"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/auth/mfa/verify": {"post": {"operationId": "verifyMfaChallenge", "tags": ["Authentication"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/LoginSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/auth/mfa/enroll": {"post": {"operationId": "enrollMfa", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/mfa/activate": {"post": {"operationId": "activateMfa", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/auth/mfa/setup": {"post": {"operationId": "setupMfaAlias", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/mfa/enable": {"post": {"operationId": "enableMfaAlias", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/auth/mfa/disable": {"post": {"operationId": "disableMfa", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/mfa/recovery-codes": {"post": {"operationId": "regenerateMfaRecoveryCodes", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/logout": {"post": {"operationId": "logoutAccount", "tags": ["Authentication"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}}}},
    "/api/v1/auth/session-token": {"post": {"operationId": "exchangeSessionCookie", "tags": ["Authentication"], "security": [{"cookieAuth": []}], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/me": {"get": {"operationId": "getCurrentAccount", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/User"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/sessions": {
      "get": {"operationId": "listAccountSessions", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "delete": {"operationId": "revokeAllAccountSessions", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/v1/auth/sessions/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "delete": {"operationId": "revokeAccountSession", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/auth/consents": {"get": {"operationId": "listAccountConsents", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/consents/{clientId}": {"parameters": [{"$ref": "#/components/parameters/ClientId"}], "delete": {"operationId": "revokeAccountConsent", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}},

    "/api/v1/users": {
      "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}],
      "get": {"operationId": "listUsers", "tags": ["Users"], "parameters": [{"name": "status", "in": "query", "schema": {"type": "string", "enum": ["active", "pending", "blocked", "deleted"]}}, {"name": "source", "in": "query", "schema": {"type": "string", "enum": ["local", "ldap", "federated"]}}], "responses": {"200": {"$ref": "#/components/responses/UserPage"}, "403": {"$ref": "#/components/responses/Forbidden"}}},
      "post": {"operationId": "createUser", "tags": ["Users"], "requestBody": {"$ref": "#/components/requestBodies/User"}, "responses": {"201": {"$ref": "#/components/responses/User"}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/users/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getUser", "tags": ["Users"], "responses": {"200": {"$ref": "#/components/responses/User"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "put": {"operationId": "updateUser", "tags": ["Users"], "requestBody": {"$ref": "#/components/requestBodies/User"}, "responses": {"200": {"$ref": "#/components/responses/User"}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}, "delete": {"operationId": "deleteUser", "tags": ["Users"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/users/{userID}/roles": {"parameters": [{"$ref": "#/components/parameters/UserId"}], "get": {"operationId": "listUserRoles", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}}}, "post": {"operationId": "assignUserRole", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/Assignment"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/users/{userID}/roles/{roleID}": {"parameters": [{"$ref": "#/components/parameters/UserId"}, {"$ref": "#/components/parameters/RoleId"}], "delete": {"operationId": "removeUserRole", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/users/{userID}/groups": {"parameters": [{"$ref": "#/components/parameters/UserId"}], "get": {"operationId": "listUserGroups", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}}}, "post": {"operationId": "assignUserGroup", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/Assignment"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/users/{userID}/groups/{groupID}": {"parameters": [{"$ref": "#/components/parameters/UserId"}, {"$ref": "#/components/parameters/GroupId"}], "delete": {"operationId": "removeUserGroup", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/users/{userID}/federated-identities": {"parameters": [{"$ref": "#/components/parameters/UserId"}], "get": {"operationId": "listUserFederatedIdentities", "tags": ["Federation"], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"operationId": "unlinkUserFederatedIdentity", "tags": ["Federation"], "requestBody": {"$ref": "#/components/requestBodies/FederatedIdentity"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}},

    "/api/v1/roles": {"parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}], "get": {"operationId": "listRoles", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonPage"}}}, "post": {"operationId": "createRole", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/NamedEntity"}, "responses": {"201": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/roles/{roleID}": {"parameters": [{"$ref": "#/components/parameters/RoleId"}], "put": {"operationId": "updateRole", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/NamedEntity"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"operationId": "deleteRole", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/roles/{roleID}/permissions": {"parameters": [{"$ref": "#/components/parameters/RoleId"}], "get": {"operationId": "listRolePermissions", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}}}, "post": {"operationId": "assignRolePermission", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/Assignment"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/roles/{roleID}/permissions/{permissionID}": {"parameters": [{"$ref": "#/components/parameters/RoleId"}, {"$ref": "#/components/parameters/PermissionId"}], "delete": {"operationId": "removeRolePermission", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/permissions": {"parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}], "get": {"operationId": "listPermissions", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonPage"}}}},
    "/api/v1/groups": {"parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}], "get": {"operationId": "listGroups", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonPage"}}}, "post": {"operationId": "createGroup", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/NamedEntity"}, "responses": {"201": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/groups/{groupID}": {"parameters": [{"$ref": "#/components/parameters/GroupId"}], "put": {"operationId": "updateGroup", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/NamedEntity"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"operationId": "deleteGroup", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/groups/{groupID}/roles": {"parameters": [{"$ref": "#/components/parameters/GroupId"}], "get": {"operationId": "listGroupRoles", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonArray"}}}, "post": {"operationId": "assignGroupRole", "tags": ["RBAC"], "requestBody": {"$ref": "#/components/requestBodies/Assignment"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/groups/{groupID}/roles/{roleID}": {"parameters": [{"$ref": "#/components/parameters/GroupId"}, {"$ref": "#/components/parameters/RoleId"}], "delete": {"operationId": "removeGroupRole", "tags": ["RBAC"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "409": {"$ref": "#/components/responses/Conflict"}}}},

    "/api/v1/audit": {"parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"name": "actor", "in": "query", "schema": {"$ref": "#/components/schemas/Uuid"}}, {"name": "action", "in": "query", "schema": {"type": "string"}}, {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}}], "get": {"operationId": "listAuditEvents", "tags": ["Audit"], "responses": {"200": {"$ref": "#/components/responses/AuditPage"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/operations/status": {"get": {"operationId": "getOperationalStatus", "tags": ["Operations"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/v1/operations/signing-keys": {"get": {"operationId": "listSigningKeys", "tags": ["Operations"], "responses": {"200": {"$ref": "#/components/responses/SigningKeyArray"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/v1/operations/signing-keys/rotate": {"post": {"operationId": "rotateSigningKey", "tags": ["Operations"], "responses": {"201": {"$ref": "#/components/responses/SigningKey"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},

    "/api/v1/ldap/providers": {"parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}, {"name": "enabled", "in": "query", "schema": {"type": "boolean"}}], "get": {"operationId": "listLdapProviders", "tags": ["LDAP"], "responses": {"200": {"$ref": "#/components/responses/JsonPage"}}}, "post": {"operationId": "createLdapProvider", "tags": ["LDAP"], "requestBody": {"$ref": "#/components/requestBodies/LdapProvider"}, "responses": {"201": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/ldap/providers/test": {"post": {"operationId": "testLdapProvider", "tags": ["LDAP"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/ldap/providers/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "put": {"operationId": "updateLdapProvider", "description": "Updates only fields present in the request; an omitted bind_password preserves the current secret.", "tags": ["LDAP"], "requestBody": {"$ref": "#/components/requestBodies/LdapProvider"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"operationId": "deleteLdapProvider", "tags": ["LDAP"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/ldap/providers/{id}/group-mappings": {"parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}], "get": {"operationId": "listLdapGroupMappings", "tags": ["LDAP"], "responses": {"200": {"$ref": "#/components/responses/JsonPage"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "post": {"operationId": "createLdapGroupMapping", "tags": ["LDAP"], "requestBody": {"$ref": "#/components/requestBodies/LdapGroupMapping"}, "responses": {"201": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/ldap/providers/{id}/group-mappings/{mappingID}": {"parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/MappingId"}], "delete": {"operationId": "deleteLdapGroupMapping", "tags": ["LDAP"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}},

    "/api/v1/identity-providers": {"parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}, {"name": "type", "in": "query", "schema": {"type": "string", "enum": ["oidc"]}}], "get": {"operationId": "listIdentityProviders", "tags": ["Federation"], "responses": {"200": {"$ref": "#/components/responses/JsonPage"}}}, "post": {"operationId": "createIdentityProvider", "tags": ["Federation"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"201": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/identity-providers/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "put": {"operationId": "updateIdentityProvider", "tags": ["Federation"], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"operationId": "deleteIdentityProvider", "tags": ["Federation"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}},

    "/api/v1/oauth/clients": {"parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Search"}, {"name": "type", "in": "query", "schema": {"type": "string", "enum": ["public", "confidential"]}}], "get": {"operationId": "listOAuthClients", "tags": ["OAuth clients"], "responses": {"200": {"$ref": "#/components/responses/JsonPage"}}}, "post": {"operationId": "createOAuthClient", "tags": ["OAuth clients"], "requestBody": {"$ref": "#/components/requestBodies/OAuthClient"}, "responses": {"201": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/oauth/clients/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getOAuthClient", "tags": ["OAuth clients"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "put": {"operationId": "updateOAuthClient", "tags": ["OAuth clients"], "requestBody": {"$ref": "#/components/requestBodies/OAuthClient"}, "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"operationId": "deleteOAuthClient", "tags": ["OAuth clients"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/oauth/clients/{id}/rotate-secret": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "rotateOAuthClientSecret", "tags": ["OAuth clients"], "responses": {"200": {"$ref": "#/components/responses/JsonSuccess"}, "404": {"$ref": "#/components/responses/NotFound"}}}}
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "HS256 access token with required iss, aud, sub, jti, iat, nbf, exp and purpose claims."},
      "cookieAuth": {"type": "apiKey", "in": "cookie", "name": "sso_session"}
    },
    "parameters": {
      "Id": {"name": "id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}},
      "UserId": {"name": "userID", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}},
      "RoleId": {"name": "roleID", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}},
      "GroupId": {"name": "groupID", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}},
      "PermissionId": {"name": "permissionID", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}},
      "MappingId": {"name": "mappingID", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}},
      "ClientId": {"name": "clientId", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
      "Offset": {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
      "Search": {"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 200}}
    },
    "schemas": {
      "Uuid": {"type": "string", "format": "uuid"},
      "Error": {"type": "object", "required": ["error", "code"], "properties": {"error": {"type": "string"}, "code": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}, "details": {"type": ["object", "array", "null"]}}, "additionalProperties": true},
      "Pagination": {"type": "object", "required": ["limit", "offset", "count"], "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 100}, "offset": {"type": "integer", "minimum": 0}, "count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
