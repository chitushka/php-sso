      "PasswordReset": {"description": "Password reset completed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordReset"}}}},
      "PasswordChanged": {"description": "Password changed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordChanged"}}}},
