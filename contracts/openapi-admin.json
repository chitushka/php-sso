    "/api/v1/auth/consents": {"get": {"operationId": "listAccountConsents", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/ConsentArray"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/consents/{clientId}": {"parameters": [{"$ref": "#/components/parameters/ClientId"}], "delete": {"operationId": "revokeAccountConsent", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/ConsentRevoked"}, "404": {"$ref": "#/components/responses/NotFound"}}}},

