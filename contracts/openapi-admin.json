      "AuditPage": {"type": "object", "required": ["items", "pagination"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/AuditEvent"}}, "pagination": {"$ref": "#/components/schemas/Pagination"}}, "additionalProperties": false},
