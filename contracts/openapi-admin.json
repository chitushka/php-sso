      "MfaDisabled": {"type": "object", "required": ["status"], "properties": {"status": {"const": "mfa_disabled"}}, "additionalProperties": false},
      "MfaRecoveryCodes": {"type": "object", "required": ["recovery_codes"], "properties": {"recovery_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
