      "EmailVerificationSent": {"type": "object", "required": ["status"], "properties": {"status": {"const": "sent"}}, "additionalProperties": false},
      "EmailVerified": {"type": "object", "required": ["status"], "properties": {"status": {"const": "email_verified"}}, "additionalProperties": false},
      "MfaEnrollment": {"type": "object", "required": ["secret", "otpauth_url"], "properties": {"secret": {"type": "string", "minLength": 1}, "otpauth_url": {"type": "string", "pattern": "^otpauth://totp/"}}, "additionalProperties": false},
