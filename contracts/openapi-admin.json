      "ChangePassword": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChangePasswordInput"}}}},
      "Profile": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileInput"}}}},
      "VerifyEmail": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VerifyEmailInput"}}}},
