{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {"title": "SSO administrative and account API", "version": "1.0.0"},
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "tags": [
    {"name": "Bootstrap"}, {"name": "Authentication"}, {"name": "Account"},
    {"name": "Users"}, {"name": "RBAC"}, {"name": "Audit"},
    {"name": "LDAP"}, {"name": "Federation"}, {"name": "OAuth clients"}, {"name": "Operations"}
  ],
  "paths": {
