      "ChangePasswordInput": {"type": "object", "required": ["old_password", "new_password"], "properties": {"old_password": {"type": ["string", "null"], "format": "password"}, "new_password": {"type": ["string", "null"], "format": "password"}}, "additionalProperties": false},
      "ProfileInput": {"type": "object", "properties": {"first_name": {"type": ["string", "null"]}, "last_name": {"type": ["string", "null"]}, "attributes": {"type": ["object", "null"], "additionalProperties": {"type": ["string", "null"]}}}, "additionalProperties": false},
      "VerifyEmailInput": {"type": "object", "required": ["token"], "properties": {"token": {"type": ["string", "null"]}}, "additionalProperties": false},
      "MfaCodeInput": {"type": "object", "required": ["code"], "properties": {"code": {"type": ["string", "null"]}}, "additionalProperties": false},
      "User": {"type": "object", "required": ["id", "username", "email", "status", "source", "first_name", "last_name", "attributes", "email_verified", "mfa_enabled", "created_at", "updated_at"], "properties": {"id": {"$ref": "#/components/schemas/Uuid"}, "username": {"type": "string"}, "email": {"type": "string", "format": "email"}, "status": {"type": "string", "enum": ["active", "pending", "blocked", "deleted"]}, "source": {"type": "string", "enum": ["local", "ldap", "federated"]}, "first_name": {"type": "string"}, "last_name": {"type": "string"}, "attributes": {"type": "object", "additionalProperties": {"type": "string"}}, "email_verified": {"type": "boolean"}, "mfa_enabled": {"type": "boolean"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "ldap_provider_id": {"$ref": "#/components/schemas/Uuid"}, "ldap_dn": {"type": "string"}, "last_login_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
      "UserInput": {"type": "object", "properties": {"username": {"type": "string"}, "email": {"type": "string", "format": "email"}, "password": {"type": "string", "format": "password"}, "status": {"type": "string"}, "first_name": {"type": "string"}, "last_name": {"type": "string"}, "attributes": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}}, "additionalProperties": false},
      "OAuthClientInput": {"type": "object", "properties": {"client_id": {"type": "string"}, "name": {"type": "string"}, "type": {"type": "string", "enum": ["public", "confidential"]}, "redirect_uris": {"type": "array", "items": {"type": "string", "format": "uri"}}, "allowed_scopes": {"type": "array", "items": {"type": "string"}}, "enabled": {"type": "boolean"}}, "additionalProperties": false}
      ,"LdapProviderInput": {"type": "object", "properties": {"name": {"type": "string"}, "host": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "use_tls": {"type": "boolean"}, "start_tls": {"type": "boolean"}, "bind_dn": {"type": "string"}, "bind_password": {"type": "string", "format": "password"}, "base_dn": {"type": "string"}, "user_filter": {"type": "string"}, "username_attribute": {"type": "string"}, "email_attribute": {"type": "string"}, "display_name_attribute": {"type": "string"}, "group_attribute": {"type": "string"}, "enabled": {"type": "boolean"}}, "additionalProperties": false},
