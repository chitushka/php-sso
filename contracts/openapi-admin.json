      "SigningKeyStatus": {"type": "object", "required": ["status", "ready", "active", "retiring", "retired"], "properties": {"status": {"type": "string", "enum": ["ready", "degraded"]}, "ready": {"type": "boolean"}, "active": {"type": "integer", "minimum": 0}, "retiring": {"type": "integer", "minimum": 0}, "retired": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
      "CleanupStatus": {"type": "object", "required": ["status", "ready", "stale", "last_success_at", "age_seconds", "interval_seconds", "max_age_seconds"], "properties": {"status": {"type": "string", "enum": ["ready", "degraded"]}, "ready": {"type": "boolean"}, "stale": {"type": "boolean"}, "last_success_at": {"type": ["string", "null"], "format": "date-time"}, "age_seconds": {"type": ["integer", "null"], "minimum": 0}, "interval_seconds": {"type": "integer", "minimum": 60}, "max_age_seconds": {"type": "integer", "minimum": 120}}, "additionalProperties": false},
      "OperationalStatus": {"type": "object", "required": ["status", "version", "environment", "database", "signing_keys", "cleanup"], "properties": {"status": {"type": "string", "enum": ["ready", "degraded"]}, "version": {"type": "string"}, "environment": {"type": "string"}, "database": {"$ref": "#/components/schemas/OperationalComponent"}, "signing_keys": {"$ref": "#/components/schemas/SigningKeyStatus"}, "cleanup": {"$ref": "#/components/schemas/CleanupStatus"}}, "additionalProperties": false},
