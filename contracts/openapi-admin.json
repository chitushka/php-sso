    "/api/v1/bootstrap": {"post": {"operationId": "bootstrapSystem", "tags": ["Bootstrap"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/Bootstrap"}, "responses": {"201": {"$ref": "#/components/responses/User"}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/TooManyRequests"}, "500": {"$ref": "#/components/responses/InternalError"}}}},
    "/api/v1/broker/providers": {"get": {"operationId": "listPublicBrokerProviders", "tags": ["Federation"], "security": [], "responses": {"200": {"$ref": "#/components/responses/PublicIdentityProviderArray"}, "429": {"$ref": "#/components/responses/TooManyRequests"}, "500": {"$ref": "#/components/responses/InternalError"}}}},

    "/api/v1/auth/login": {"post": {"operationId": "login", "tags": ["Authentication"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/Login"}, "responses": {"200": {"$ref": "#/components/responses/LoginResult"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/password/forgot": {"post": {"operationId": "forgotPassword", "tags": ["Account"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/ForgotPassword"}, "responses": {"200": {"$ref": "#/components/responses/ForgotPasswordAccepted"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/auth/password/reset": {"post": {"operationId": "resetPassword", "tags": ["Account"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/ResetPassword"}, "responses": {"200": {"$ref": "#/components/responses/PasswordReset"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/auth/password/change": {"post": {"operationId": "changePassword", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/ChangePassword"}, "responses": {"200": {"$ref": "#/components/responses/PasswordChanged"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/profile": {"put": {"operationId": "updateProfile", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/Profile"}, "responses": {"200": {"$ref": "#/components/responses/User"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/email/request": {"post": {"operationId": "requestEmailVerification", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/EmailVerificationSent"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/email/verify": {"post": {"operationId": "verifyEmail", "tags": ["Account"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/VerifyEmail"}, "responses": {"200": {"$ref": "#/components/responses/EmailVerified"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/auth/mfa/verify": {"post": {"operationId": "verifyMfaChallenge", "tags": ["Authentication"], "security": [], "requestBody": {"$ref": "#/components/requestBodies/MfaVerification"}, "responses": {"200": {"$ref": "#/components/responses/LoginSuccess"}, "400": {"$ref": "#/components/responses/BadRequest"}, "429": {"$ref": "#/components/responses/TooManyRequests"}, "500": {"$ref": "#/components/responses/InternalError"}}}},
    "/api/v1/auth/mfa/enroll": {"post": {"operationId": "enrollMfa", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/MfaEnrollment"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/mfa/activate": {"post": {"operationId": "activateMfa", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/MfaCode"}, "responses": {"200": {"$ref": "#/components/responses/MfaEnabled"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/auth/mfa/setup": {"post": {"operationId": "setupMfaAlias", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/MfaEnrollment"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/mfa/enable": {"post": {"operationId": "enableMfaAlias", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/MfaCode"}, "responses": {"200": {"$ref": "#/components/responses/MfaEnabled"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/api/v1/auth/mfa/disable": {"post": {"operationId": "disableMfa", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/MfaCode"}, "responses": {"200": {"$ref": "#/components/responses/MfaDisabled"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/mfa/recovery-codes": {"post": {"operationId": "regenerateMfaRecoveryCodes", "tags": ["Account"], "requestBody": {"$ref": "#/components/requestBodies/MfaCode"}, "responses": {"200": {"$ref": "#/components/responses/MfaRecoveryCodes"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/logout": {"post": {"operationId": "logoutAccount", "tags": ["Authentication"], "responses": {"200": {"$ref": "#/components/responses/LoggedOut"}}}},
    "/api/v1/auth/session-token": {"post": {"operationId": "exchangeSessionCookie", "tags": ["Authentication"], "security": [{"cookieAuth": []}], "responses": {"200": {"$ref": "#/components/responses/SessionToken"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/me": {"get": {"operationId": "getCurrentAccount", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/User"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/auth/sessions": {
      "get": {"operationId": "listAccountSessions", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/SessionArray"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "delete": {"operationId": "revokeAllAccountSessions", "tags": ["Account"], "responses": {"200": {"$ref": "#/components/responses/AllSessionsRevoked"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
