<?xml version="1.0"?>
<ruleset name="SSO PHP">
    <description>PSR-12 quality gate.</description>
    <file>commands</file>
    <file>components</file>
    <file>config</file>
    <file>controllers</file>
    <file>models</file>
    <file>services</file>
    <exclude-pattern>config/__autocomplete.php</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <rule ref="PSR12"/>
</ruleset>
