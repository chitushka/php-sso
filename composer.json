{
  "name": "local/sso-php",
  "description": "Single-tenant SSO service implemented on PHP 8.4 and Yii2.",
  "license": "BSD-3-Clause",
  "type": "project",
  "minimum-stability": "stable",
  "require": {
    "php": "^8.4",
    "yiisoft/yii2": "^2.0"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "extra": {
    "yii\\composer\\Installer::postCreateProject": {
      "setPermission": [
        {
          "runtime": "0777",
          "web/assets": "0777",
          "yii": "0755"
        }
      ]
    },
    "yii\\composer\\Installer::postInstall": {
      "generateCookieValidationKey": [
        "config/web.php"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": [
      "yii\\composer\\Installer::postInstall"
    ],
    "post-create-project-cmd": [
      "yii\\composer\\Installer::postCreateProject",
      "yii\\composer\\Installer::postInstall"
    ],
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print -exec php -l {} \\;",
    "cs": "phpcs -n --standard=phpcs.xml.dist",
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration",
    "test:coverage": "phpunit --testsuite Integration --coverage-clover=runtime/coverage.xml",
    "verify:coverage": "php scripts/ci/check_coverage.php runtime/coverage.xml 35",
    "verify:assets": "php scripts/ci/verify_assets.php",
    "verify:docs": "php scripts/ci/verify_docs.php",
    "verify:contracts": "php scripts/ci/openapi_contract_check.php",
    "verify:compose": "php scripts/ci/compose_perimeter_check.php",
    "verify:secrets": "php scripts/ci/secret_scan.php",
    "security:audit": "composer audit --locked --no-dev",
    "quality": ["@lint", "@cs", "@analyse", "@verify:assets", "@verify:docs", "@verify:contracts", "@verify:compose", "@verify:secrets"],
    "test": "phpunit",
    "migrate": "php yii migrate --interactive=0",
    "serve": "php -S 0.0.0.0:8080 -t web web/router.php"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "process-timeout": 1800
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.1"
  }
}
